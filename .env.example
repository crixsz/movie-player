# TMDB API Key - Required for movie/TV show information
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OpenSubtitles API Key - Required for subtitle functionality
# Get your API key from: https://www.opensubtitles.org/en/users/osapi
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here

# Backend URL - Used by the frontend to connect to the backend
# In production, this should be your domain or server IP
# For Docker deployment, use port 3000 for backend API
VITE_BACKEND_URL=http://localhost:3000

# Frontend API Key - Required for authenticating frontend requests to backend
# Generate a secure random key for authentication between frontend and backend
# Example: you can generate this with: openssl rand -hex 32
VITE_API_KEY=62203c4461b7e6c38ab8e9b2d2c1835a09127662eb212f4f11a61ab28f03217a

# Backend API Key - Must match the frontend key for authentication
# This should be the SAME value as VITE_API_KEY above
FRONTEND_API_KEY=62203c4461b7e6c38ab8e9b2d2c1835a09127662eb212f4f11a61ab28f03217a
