# TMDB API Key - Required for movie/TV show information
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OpenSubtitles API Key - Required for subtitle functionality
# Get your API key from: https://www.opensubtitles.org/en/users/osapi
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here

# Backend URL - Used by the frontend to connect to the backend
# In production, this should be your domain or server IP
# For Docker deployment, use port 3000 for backend API
VITE_BACKEND_URL=http://localhost:3000
