# Frontend Dockerfile
FROM node:18-alpine AS build

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install pnpm globally
RUN npm install -g pnpm

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./
COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./

# Set build-time environment variables
ARG VITE_BACKEND_URL=http://localhost:3000
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

# Debug: Print the environment variable
RUN echo "Building with VITE_BACKEND_URL: ${VITE_BACKEND_URL}"

# Build the frontend for production
RUN pnpm run build

# Debug: Check if the environment variable was embedded in the build
RUN grep -r "VITE_BACKEND_URL" dist/ || echo "VITE_BACKEND_URL not found in build files"

# Production stage
FROM node:18-alpine AS production

# Install serve globally
RUN npm install -g serve

# Create app directory
WORKDIR /app

# Copy built frontend from build stage
COPY --from=build /app/dist ./dist

# Create a non-root user for security
RUN addgroup -g 1001 -S nodejs
RUN adduser -S movieplayer -u 1001

# Change ownership of the app directory
RUN chown -R movieplayer:nodejs /app
USER movieplayer

# Expose frontend port
EXPOSE 8118

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "const http=require('http');http.get('http://localhost:8118',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# Start the frontend server with serve
# Note: serve automatically binds to 0.0.0.0 in Docker containers
CMD ["serve", "-s", "dist", "-l", "8118"]
